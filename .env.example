# EXPO_PUBLIC_API_URL=https://api.lingohouse.app
EXPO_PUBLIC_API_URL=http://localhost:3000
# EXPO_PUBLIC_API_URL=http://192.168.40.147:3000

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=4254790883-6vnn38qq5tap3aiv8un367dcn8h5vco9.apps.googleusercontent.com

# reCAPTCHA v3 site key for Firebase App Check on web.
# Required in production; in dev the App Check debug token flow is used instead.
EXPO_PUBLIC_FIREBASE_RECAPTCHA_SITE_KEY=
# production | development
# Also decides storage paths: any value other than 'production' roots
# uploads under a `devenv/` prefix, matching how the API derives it from
# NODE_ENV. Production builds MUST set this to 'production'.
EXPO_PUBLIC_APP_ENV=development
