rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }
    function isValidVideo() {
      return request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|quicktime)');
    }
    function isValidImage() {
      return request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    function isValidAudio() {
      return request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('audio/(mp4|mpeg|wav)');
    }

    // Platform deck draft — card audio clips
    match /platformDeckDrafts/{uid}/{draftId}/audio/cards/{filename} {
      allow read:  if isOwner(uid) && isAdmin();
      allow write: if isOwner(uid) && isAdmin() && isValidAudio();
    }

    // Platform deck draft — video
    match /platformDeckDrafts/{uid}/{draftId}/video/{filename} {
      allow read:  if isOwner(uid) && isAdmin();
      allow write: if isOwner(uid) && isAdmin() && isValidVideo();
    }

    // Platform deck draft — cover/card images
    match /platformDeckDrafts/{uid}/{draftId}/images/{filename} {
      allow read:  if isOwner(uid) && isAdmin();
      allow write: if isOwner(uid) && isAdmin() && isValidImage();
    }

    // Game draft — cover/character images. Also used to stage replacement
    // images for published games (the game id sits in the draftId slot).
    match /gameDrafts/{uid}/{draftId}/images/{filename} {
      allow read:  if isOwner(uid) && isAdmin();
      allow write: if isOwner(uid) && isAdmin() && isValidImage();
    }

    // =========================================================================
    // Dev environment
    // Dev and production share this bucket, so dev objects are namespaced
    // under /devenv (derived from NODE_ENV in the API and
    // EXPO_PUBLIC_APP_ENV in the apps). Production paths stay at
    // the root, so these blocks must mirror the ones above exactly — a rule
    // added above without its counterpart here breaks dev uploads, which then
    // fall through to the deny-all below.
    // =========================================================================

    // Platform deck draft — card audio clips
    match /devenv/platformDeckDrafts/{uid}/{draftId}/audio/cards/{filename} {
      allow read:  if isOwner(uid) && isAdmin();
      allow write: if isOwner(uid) && isAdmin() && isValidAudio();
    }

    // Platform deck draft — video
    match /devenv/platformDeckDrafts/{uid}/{draftId}/video/{filename} {
      allow read:  if isOwner(uid) && isAdmin();
      allow write: if isOwner(uid) && isAdmin() && isValidVideo();
    }

    // Platform deck draft — cover/card images. Also used to stage replacement
    // images for published decks (the deck id sits in the draftId slot).
    match /devenv/platformDeckDrafts/{uid}/{draftId}/images/{filename} {
      allow read:  if isOwner(uid) && isAdmin();
      allow write: if isOwner(uid) && isAdmin() && isValidImage();
    }

    // Game draft — cover/character images. Also used to stage replacement
    // images for published games (the game id sits in the draftId slot).
    match /devenv/gameDrafts/{uid}/{draftId}/images/{filename} {
      allow read:  if isOwner(uid) && isAdmin();
      allow write: if isOwner(uid) && isAdmin() && isValidImage();
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
