rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }
    function isValidVideo() {
      return request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|quicktime)');
    }
    function isValidImage() {
      return request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    // Per-card clips. The content types must stay in step with
    // FILE_LIMITS.audio in the admin app: the client validates against that
    // list, so anything it accepts and this rejects fails here as a bare
    // "Upload failed" with nothing to explain it. Chrome reports a .m4a picked
    // through the OS dialog as audio/x-m4a, which is exactly how that gap first
    // showed up — the type was added to the deck-audio list below and not here.
    function isValidAudio() {
      return request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('audio/(mp4|x-m4a|mpeg|wav|wave|x-wav|vnd.wave)');
    }
    // Deck-level audio is a whole track rather than a per-card clip, so it gets
    // a much larger cap (see FILE_LIMITS.deckAudio in the admin app). The
    // content types mirror that same allow-list.
    function isValidDeckAudio() {
      return request.resource.size < 60 * 1024 * 1024
        && request.resource.contentType.matches('audio/(mp4|x-m4a|mpeg|wav|wave|x-wav|vnd.wave)');
    }

    // Platform deck draft — card audio clips
    match /platformDeckDrafts/{uid}/{draftId}/audio/cards/{filename} {
      allow read:  if isOwner(uid) && isAdmin();
      allow write: if isOwner(uid) && isAdmin() && isValidAudio();
    }

    // Platform deck draft — deck-level audio track. Distinct from the rule
    // above: {filename} matches a single segment, so the two never overlap.
    // Also used to stage audio added to an already-published deck (the deck id
    // sits in the draftId slot).
    match /platformDeckDrafts/{uid}/{draftId}/audio/{filename} {
      allow read:  if isOwner(uid) && isAdmin();
      allow write: if isOwner(uid) && isAdmin() && isValidDeckAudio();
    }

    // Platform deck draft — video
    match /platformDeckDrafts/{uid}/{draftId}/video/{filename} {
      allow read:  if isOwner(uid) && isAdmin();
      allow write: if isOwner(uid) && isAdmin() && isValidVideo();
    }

    // Platform deck draft — cover/card images
    match /platformDeckDrafts/{uid}/{draftId}/images/{filename} {
      allow read:  if isOwner(uid) && isAdmin();
      allow write: if isOwner(uid) && isAdmin() && isValidImage();
    }

    // Game draft — cover/character images. Also used to stage replacement
    // images for published games (the game id sits in the draftId slot).
    match /gameDrafts/{uid}/{draftId}/images/{filename} {
      allow read:  if isOwner(uid) && isAdmin();
      allow write: if isOwner(uid) && isAdmin() && isValidImage();
    }

    // =========================================================================
    // Dev environment
    // Dev and production share this bucket, so dev objects are namespaced
    // under /devenv (derived from NODE_ENV in the API and
    // EXPO_PUBLIC_APP_ENV in the apps). Production paths stay at
    // the root, so these blocks must mirror the ones above exactly — a rule
    // added above without its counterpart here breaks dev uploads, which then
    // fall through to the deny-all below.
    // =========================================================================

    // Platform deck draft — card audio clips
    match /devenv/platformDeckDrafts/{uid}/{draftId}/audio/cards/{filename} {
      allow read:  if isOwner(uid) && isAdmin();
      allow write: if isOwner(uid) && isAdmin() && isValidAudio();
    }

    // Platform deck draft — deck-level audio track
    match /devenv/platformDeckDrafts/{uid}/{draftId}/audio/{filename} {
      allow read:  if isOwner(uid) && isAdmin();
      allow write: if isOwner(uid) && isAdmin() && isValidDeckAudio();
    }

    // Platform deck draft — video
    match /devenv/platformDeckDrafts/{uid}/{draftId}/video/{filename} {
      allow read:  if isOwner(uid) && isAdmin();
      allow write: if isOwner(uid) && isAdmin() && isValidVideo();
    }

    // Platform deck draft — cover/card images. Also used to stage replacement
    // images for published decks (the deck id sits in the draftId slot).
    match /devenv/platformDeckDrafts/{uid}/{draftId}/images/{filename} {
      allow read:  if isOwner(uid) && isAdmin();
      allow write: if isOwner(uid) && isAdmin() && isValidImage();
    }

    // Game draft — cover/character images. Also used to stage replacement
    // images for published games (the game id sits in the draftId slot).
    match /devenv/gameDrafts/{uid}/{draftId}/images/{filename} {
      allow read:  if isOwner(uid) && isAdmin();
      allow write: if isOwner(uid) && isAdmin() && isValidImage();
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
